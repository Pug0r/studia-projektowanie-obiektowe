<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="utf-8" />
  <title>Produkty</title>
</head>
<body>
  <h1>Produkty</h1>
  <table border="1" cellpadding="6" cellspacing="0">
    <thead>
      <tr>
        <th>Nazwa</th>
        <th>Cena</th>
      </tr>
    </thead>
    <tbody>
    #for(product in products):
      <tr>
        <td>#(product.name)</td>
        <td>#(product.price)</td>
      </tr>
    #endfor
    </tbody>
  </table>
</body>
</html>
